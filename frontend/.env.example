NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="MatriConnect"

# Secret shared with Laravel — used to purge ISR cache after admin CMS/settings changes
REVALIDATE_SECRET=your-revalidate-secret

# Cloudflare Images (production only — leave empty for demo)
NEXT_PUBLIC_CF_IMAGE_DELIVERY_URL=
NEXT_PUBLIC_CF_ACCOUNT_HASH=

# Laravel Reverb (WebSocket)
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

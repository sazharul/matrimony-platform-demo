APP_NAME=MatriConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_URL="${FRONTEND_URL}/dashboard"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=matriconnect
DB_USERNAME=matriconnect
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@matriconnect.demo"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=matriconnect-media
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
AWS_URL=

SCOUT_DRIVER=database

L5_SWAGGER_CONST_HOST=http://localhost:8000

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Demo mode — bypasses SSLCommerz and activates subscriptions directly
DEMO_MODE=true

# WebRTC / TURN server (optional — required for voice/video calls)
TURN_SERVER_HOST=localhost
TURN_SERVER_PORT=3478
TURN_SERVER_TLS_PORT=5349
TURN_ENABLE_TLS=false
TURN_AUTH_MODE=static
TURN_USERNAME=demo
TURN_PASSWORD=demo-password
TURN_SECRET=
TURN_CREDENTIAL_TTL=86400

# Cloudflare Images (production only — leave empty for demo)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_HASH=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_DELIVERY_URL=

# SSLCommerz Payment Gateway (sandbox placeholders — not used when DEMO_MODE=true)
SSLCZ_STORE_ID=your-store-id
SSLCZ_STORE_PASSWD=your-store-password
SSLCZ_IS_LIVE=false

FRONTEND_REVALIDATE_SECRET=your-revalidate-secret
